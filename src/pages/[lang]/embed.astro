---
import Layout from '../../components/Layout.astro';
import { LANGS, t, fees, defaultAsset, SITE_URL } from '../../data';
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const D = defaultAsset();
const L = (p: string) => `/${lang}${p}`;
const code = (src: string, h: number) => `<iframe src="${SITE_URL}${src}" title="${t(lang, 'site.name')}" width="100%" height="${h}" style="max-width:420px;border:0;border-radius:12px" loading="lazy"></iframe>`;
const usdtNets = Object.values(D.networks).map((c: any) => ({ id: c.network, name: c.name })) as any[];
---
<Layout lang={lang} title={t(lang, 'embed.title')} description={t(lang, 'embed.description')} path={L('/embed/')} crumbs={[{ name: t(lang, 'embed.title'), path: L('/embed/') }]}>
  <div class="hero"><p class="eyebrow">{t(lang, 'nav.embed')}</p><h1>{t(lang, 'embed.h1')}</h1>
  <p class="lead">{t(lang, 'embed.intro')}</p></div>
  <h2>{t(lang, 'embed.cheapest')}</h2>
  <iframe src="/embed/cheapest-network/" title={t(lang, 'widget.cheapest', { asset: D.symbol })} width="100%" height="150" style="max-width:420px;border:0;border-radius:12px"></iframe>
  <div class="codebox"><textarea class="code" readonly rows="3" aria-label={t(lang, 'embed.code_label')}>{code('/embed/cheapest-network/', 150)}</textarea><button type="button" class="copy" data-copy data-label={t(lang, 'embed.copy')} data-done-label={t(lang, 'embed.copied')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>{t(lang, 'embed.copy')}</span></button></div>
  <h2>{t(lang, 'embed.network')}</h2>
  <label>{t(lang, 'calc.network')} <select id="pick">{usdtNets.map((n) => <option value={n.id}>{n.name}</option>)}</select></label>
  <p><iframe id="prev" src={`/embed/network/${usdtNets[0].id}/`} title={t(lang, 'widget.fee_now', { asset: D.symbol })} width="100%" height="150" style="max-width:420px;border:0;border-radius:12px"></iframe></p>
  <div class="codebox"><textarea class="code" id="netcode" readonly rows="3" aria-label={t(lang, 'embed.code_label')}>{code(`/embed/network/${usdtNets[0].id}/`, 150)}</textarea><button type="button" class="copy" data-copy data-label={t(lang, 'embed.copy')} data-done-label={t(lang, 'embed.copied')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg><span>{t(lang, 'embed.copy')}</span></button></div>
  <script is:inline define:vars={{ SITE_URL, title: t(lang, 'site.name') }}>
    document.getElementById('pick').addEventListener('change', function (e) { var id = e.target.value; document.getElementById('prev').src = '/embed/network/' + id + '/'; document.getElementById('netcode').value = '<iframe src="' + SITE_URL + '/embed/network/' + id + '/" title="' + title + '" width="100%" height="150" style="max-width:420px;border:0;border-radius:12px" loading="lazy"></iframe>'; });
    document.querySelectorAll('textarea.code').forEach(function (t) { t.addEventListener('focus', function () { t.select(); }); });
    // One tap copies the code: the clipboard API where allowed, else select + the old copy command.
    document.querySelectorAll('[data-copy]').forEach(function (b) { b.addEventListener('click', function () {
      var t = b.parentNode.querySelector('textarea'), text = t.value, done = function () { b.dataset.done = '1'; b.querySelector('span').textContent = b.dataset.doneLabel; setTimeout(function () { b.dataset.done = ''; b.querySelector('span').textContent = b.dataset.label; }, 1800); };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, function () { t.focus(); t.select(); document.execCommand('copy'); done(); });
      else { t.focus(); t.select(); document.execCommand('copy'); done(); }
    }); });
  </script>
</Layout>
