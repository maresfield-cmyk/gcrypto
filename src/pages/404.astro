---
import Layout from '../components/Layout.astro';
import { t } from '../data';
const lang = 'en';
---
<Layout lang={lang} title="404" description={t(lang, 'notfound.title')} path="/404/">
  <div class="hero"><h1>404</h1><p class="lead">{t(lang, 'notfound.text')} <a href="/en/">{t(lang, 'nav.home')}</a></p>
  <p class="lead" lang="ar" dir="rtl">{t(lang, 'notfound.text_ar')} <a href="/ar/">{t('ar', 'nav.home')}</a></p></div>
</Layout>
