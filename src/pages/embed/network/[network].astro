---
import Widget from '../../../components/Widget.astro';
import { t, fees, defaultAsset, fmtUsd, fmtTime } from '../../../data';
export const getStaticPaths = () => Object.keys(defaultAsset().networks).map((network) => ({ params: { network } }));
const { network } = Astro.params; const lang = 'en', F = fees(), D = defaultAsset(), n = D.networks[network];
---
<Widget lang={lang} title={`${n.name}: ${t(lang, 'widget.fee_now', { asset: D.symbol })}`} refresh={`${D.id}:${network}`}><div class="t">{n.name} · {t(lang, 'widget.fee_now', { asset: D.symbol })}</div><div class="f">{fmtUsd(lang, n.fee_usd)}</div><div class="s">{t(lang, 'minutes', { n: n.eta_min })} · {t(lang, 'updated', { time: fmtTime(lang, F.generated_at) })}</div></Widget>
