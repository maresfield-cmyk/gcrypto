---
import Widget from '../../components/Widget.astro';
import { t, fees, defaultAsset, cheapestOf, fmtUsd, fmtTime } from '../../data';
const lang = 'en', F = fees(), D = defaultAsset(), b = cheapestOf(F, D.id);
---
<Widget lang={lang} title={t(lang, 'widget.cheapest', { asset: D.symbol })} refresh={`cheapest:${D.id}`}><div class="t">{t(lang, 'widget.cheapest', { asset: D.symbol })}</div><div class="n">{b?.name}</div><div class="f">{fmtUsd(lang, b?.fee_usd)}</div><div class="s">{t(lang, 'updated', { time: fmtTime(lang, F.generated_at) })}</div></Widget>
