---
// Page shell: header nav, footer, dark mode, logical CSS (RTL-ready), structured data, client-side refresh of live numbers.
import { t, dir, SITE_URL, fmtTime } from '../data';
interface Props { lang: string; title: string; description: string; path: string; og?: string; updated?: string; crumbs?: { name: string; path: string }[]; jsonld?: object[] }
const { lang, title, description, path, og, updated, crumbs = [], jsonld = [] } = Astro.props;
const L = (p: string) => `/${lang}${p}`;
const NAV = [['/', 'nav.home'], ['/calculator/', 'nav.calculator'], ['/compare/usdt-withdrawal-fees/', 'nav.compare'], ['/history/', 'nav.history'], ['/methodology/', 'nav.methodology'], ['/embed/', 'nav.embed']];
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: t(lang, 'breadcrumb.home'), item: `${SITE_URL}${L('/')}` }, ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: `${SITE_URL}${c.path}` }))] };
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title} | {t(lang, 'site.name')}</title>
<meta name="description" content={description}>
<link rel="canonical" href={`${SITE_URL}${path}`}>
<link rel="alternate" hreflang="en" href={`${SITE_URL}/en${path.replace(/^\/[a-z]{2}/, '')}`}>
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:url" content={`${SITE_URL}${path}`}>
{og && <meta property="og:image" content={`${SITE_URL}${og}`} />}{og && <meta name="twitter:card" content="summary_large_image" />}
<meta name="color-scheme" content="light dark"><link rel="icon" href="/favicon.svg" type="image/svg+xml">
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<style is:global>
  :root { --bg: #ffffff; --fg: #15191e; --muted: #5b6672; --line: #e3e7ec; --card: #f6f8fa; --accent: #0b6d63; --accent-ink: #ffffff; --good: #1b7f3b; --warn: #b45309; --bad: #b91c1c; --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color-scheme: light dark; }
  @media (prefers-color-scheme: dark) { :root { --bg: #0e1217; --fg: #e8ecf1; --muted: #9aa5b1; --line: #263040; --card: #161c24; --accent: #3dd6c3; --accent-ink: #06201c; --good: #4ade80; --warn: #fbbf24; --bad: #f87171; } }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans Arabic", sans-serif; }
  a { color: var(--accent); }
  .wrap { max-width: 1080px; margin: 0 auto; padding-inline: 16px; }
  header.top { border-block-end: 1px solid var(--line); }
  header.top .wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 18px; min-height: 56px; padding-block: 8px; }
  .brand { font-weight: 800; letter-spacing: 0.01em; text-decoration: none; color: var(--fg); margin-inline-end: auto; }
  nav.main { display: flex; flex-wrap: wrap; gap: 2px; }
  nav.main a { padding: 6px 10px; border-radius: 8px; text-decoration: none; color: var(--fg); font-size: 15px; }
  nav.main a[aria-current="page"], nav.main a:hover { background: var(--card); }
  main { padding-block: 20px 40px; }
  h1 { font-size: clamp(24px, 4vw, 34px); line-height: 1.2; margin: 0 0 8px; letter-spacing: -0.01em; }
  h2 { font-size: clamp(19px, 3vw, 24px); margin: 32px 0 10px; }
  p.lead { color: var(--muted); margin: 0 0 16px; max-width: 70ch; }
  .meta { color: var(--muted); font-size: 13px; }
  .grid { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
  .card .name { font-weight: 700; }
  .card .fee { font-size: 26px; font-weight: 800; font-variant-numeric: tabular-nums; margin: 4px 0; }
  .card .sub { color: var(--muted); font-size: 13px; }
  .num { font-variant-numeric: tabular-nums; }
  table { width: 100%; border-collapse: collapse; font-size: 15px; }
  th, td { text-align: start; padding: 8px 10px; border-block-end: 1px solid var(--line); vertical-align: top; }
  th { font-size: 13px; color: var(--muted); font-weight: 600; }
  th.sortable { cursor: pointer; user-select: none; } th.sortable::after { content: " ↕"; opacity: 0.5; }
  td.num, th.num { text-align: end; }
  .scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
  .scroll table { min-width: 640px; } .scroll th, .scroll td { white-space: nowrap; }
  .pill { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; font-weight: 700; background: var(--card); border: 1px solid var(--line); }
  .pill.good { color: var(--good); } .pill.warn { color: var(--warn); } .pill.bad { color: var(--bad); }
  .best { color: var(--good); font-weight: 800; }
  .stale { color: var(--warn); }
  .two { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .note { border-inline-start: 4px solid var(--accent); background: var(--card); padding: 12px 14px; border-radius: 0 10px 10px 0; }
  [dir="rtl"] .note { border-radius: 10px 0 0 10px; }
  code, pre, textarea.code { font-family: var(--mono); font-size: 13px; }
  pre, textarea.code { background: var(--card); border: 1px solid var(--line); border-radius: 10px; padding: 12px; overflow: auto; width: 100%; direction: ltr; text-align: left; }
  button, select, input { font: inherit; } 
  .btn { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border: 0; border-radius: 10px; background: var(--accent); color: var(--accent-ink); font-weight: 700; cursor: pointer; }
  footer.bottom { border-block-start: 1px solid var(--line); padding: 20px 0 32px; color: var(--muted); font-size: 13px; }
  footer.bottom p { margin: 4px 0; }
  .spark { width: 110px; height: 30px; display: block; }
  dl.kv { display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; margin: 0; } dl.kv dt { color: var(--muted); } dl.kv dd { margin: 0; }
  @media (max-width: 640px) { nav.main a { padding: 6px 8px; font-size: 14px; } }
</style>
</head>
<body>
<header class="top"><div class="wrap">
  <a class="brand" href={L('/')}>{t(lang, 'site.name')}</a>
  <nav class="main" aria-label="Main">{NAV.map(([p, k]) => <a href={L(p)} aria-current={path === L(p) ? 'page' : undefined}>{t(lang, k)}</a>)}</nav>
</div></header>
<main class="wrap">
  {updated && <p class="meta" data-live="updated">{t(lang, 'updated', { time: fmtTime(lang, updated) })}</p>}
  <slot />
</main>
<footer class="bottom"><div class="wrap">
  <p>{t(lang, 'site.footer_note')}</p>
  <p>{t(lang, 'site.footer_project')} · <a href={L('/methodology/')}>{t(lang, 'nav.methodology')}</a></p>
</div></footer>
<script is:inline define:vars={{ lang }}>
  // Live refresh: every 5 minutes, re-read the published JSON and update any element tagged data-live-fee="<network>" (USD)
  (function () {
    var fmt = function (v) { return new Intl.NumberFormat(lang, { style: 'currency', currency: 'USD', maximumFractionDigits: v < 0.01 ? 4 : v < 1 ? 3 : 2 }).format(v); };
    function tick() {
      fetch('/data/networks.json', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
        document.querySelectorAll('[data-live-fee]').forEach(function (el) { var n = d.networks[el.getAttribute('data-live-fee')]; if (n && n.fee_usd != null) el.textContent = fmt(n.fee_usd); });
        var u = document.querySelector('[data-live="updated"]'); if (u && d.generated_at) u.textContent = u.textContent.replace(/\S.*$/, '').trim() ? u.textContent : u.textContent;
      }).catch(function () {});
    }
    setInterval(tick, 5 * 60 * 1000);
  })();
</script>
</body>
</html>
