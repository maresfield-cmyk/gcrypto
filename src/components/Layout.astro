---
// Page shell: header nav, footer, dark mode, logical CSS (RTL-ready), structured data, client-side refresh of live numbers.
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-arabic';
import { t, dir, LANGS, LANG_NAMES, SITE_URL, fmtTime } from '../data';
interface Props { lang: string; title: string; description: string; path: string; og?: string; updated?: string; crumbs?: { name: string; path: string }[]; jsonld?: object[] }
const { lang, title, description, path, og, updated, crumbs = [], jsonld = [] } = Astro.props;
// Search engines cut titles at about 60 characters: keep the site name only when the whole thing fits.
const stripped = path.replace(/^\/[a-z]{2}(?=\/|$)/, '');
const langPath = (l: string) => `/${l}${stripped}`;
const fullTitle = `${title} | ${t(lang, 'site.name')}`.length <= 60 ? `${title} | ${t(lang, 'site.name')}` : title;
const L = (p: string) => `/${lang}${p}`;
const NAV = [['/', 'nav.home'], ['/calculator/', 'nav.calculator'], ['/compare/usdt-withdrawal-fees/', 'nav.compare'], ['/history/', 'nav.history'], ['/methodology/', 'nav.methodology'], ['/embed/', 'nav.embed']];
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: t(lang, 'breadcrumb.home'), item: `${SITE_URL}${L('/')}` }, ...crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 2, name: c.name, item: `${SITE_URL}${c.path}` }))] };
---
<!doctype html>
<html lang={lang} dir={dir(lang)}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="canonical" href={`${SITE_URL}${path}`}>
{LANGS.map((l) => <link rel="alternate" hreflang={l} href={`${SITE_URL}${langPath(l)}`} />)}<link rel="alternate" hreflang="x-default" href={`${SITE_URL}${langPath('en')}`}>
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website"><meta property="og:url" content={`${SITE_URL}${path}`}>
<meta property="og:site_name" content={t(lang, 'site.name')}><meta property="og:locale" content={lang === 'ar' ? 'ar_AE' : 'en_GB'}><meta property="og:image" content={`${SITE_URL}${og || '/og/default.png'}`}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content={title}>
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={fullTitle}><meta name="twitter:description" content={description}><meta name="twitter:image" content={`${SITE_URL}${og || '/og/default.png'}`}>
<meta name="color-scheme" content="light dark"><link rel="icon" href="/favicon.png" type="image/png" sizes="64x64"><link rel="apple-touch-icon" href="/logo-180.png">
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
<style is:global>
  /* Design tokens: a fintech palette (graphite + electric teal), Inter, generous whitespace, soft elevated surfaces. */
  :root { --box: color-mix(in srgb, #0f9d8e 45%, #e2e8f0); --bg: #f7f8fb; --bg-2: #ffffff; --fg: #0f172a; --fg-2: #334155; --muted: #596a7d; --line: #e2e8f0; --line-2: #cbd5e1; --card: #ffffff; --tint: #eef6f5;
    --accent: #0f9d8e; --accent-text: #0b7268; --accent-2: #2563eb; --accent-ink: #ffffff; --good: #15803d; --warn: #b45309; --bad: #b91c1c;
    --shadow: 0 1px 2px rgba(15,23,42,.04), 0 8px 24px -12px rgba(15,23,42,.12); --radius: 16px; --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color-scheme: light dark; }
  @media (prefers-color-scheme: dark) { :root { --box: color-mix(in srgb, #2dd4bf 40%, #1e2a3a); --bg: #0b0f17; --bg-2: #0f1522; --fg: #e6edf7; --fg-2: #c3cdd9; --muted: #8b98a8; --line: #1e2a3a; --line-2: #2b394c; --card: #111827; --tint: #0f2420;
    --accent: #2dd4bf; --accent-text: #2dd4bf; --accent-2: #60a5fa; --accent-ink: #04201c; --good: #4ade80; --warn: #fbbf24; --bad: #f87171; --shadow: 0 1px 2px rgba(0,0,0,.4), 0 12px 32px -16px rgba(0,0,0,.7); } }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  html { overflow-x: clip; }
  body { overflow-x: clip; margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.6 "Inter Variable", Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans Arabic", sans-serif; font-feature-settings: "cv11", "ss01"; -webkit-font-smoothing: antialiased; }
  a { color: var(--accent-text); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--accent-2); }
  .wrap { max-width: 1200px; margin: 0 auto; padding-inline: clamp(16px, 4vw, 32px); }
  header.top { position: fixed; top: 0; inset-inline: 0; z-index: 20; backdrop-filter: saturate(180%) blur(14px); -webkit-backdrop-filter: saturate(180%) blur(14px); background: color-mix(in srgb, var(--bg) 78%, transparent); border-block-end: 1px solid var(--line); }
  header.top .wrap { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 20px; min-height: 64px; padding-block: 10px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: -0.01em; text-decoration: none; color: var(--fg); margin-inline-end: auto; font-size: 17px; }
  .brand .mark { width: 32px; height: 32px; border-radius: 9px; flex: none; display: block; }
  .tools { display: flex; align-items: center; flex: none; }
  .brand { flex: 1 1 0; min-width: 0; }   /* basis 0: the name never forces the buttons onto a new line; it grows into the space left */ .brand > span { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Telegram channel button, left of the language menu */
  .tg { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 999px; border: 1px solid var(--box); background: var(--card); color: var(--accent-text); margin-inline-end: 8px; transition: border-color .15s, background .15s; }
  .tg:hover { border-color: var(--accent); background: var(--tint); }
  .tg svg { width: 19px; height: 19px; }
  @media (max-width: 640px) { .tg { width: 34px; height: 34px; margin-inline-end: 6px; } }
  header.top.scrolled .tg { width: 30px; height: 30px; } header.top.scrolled .tg svg { width: 16px; height: 16px; }
  /* Language menu: globe + current language, opens a two-item list */
  .lmenu { position: relative; }
  .lmenu > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; min-height: 36px; padding: 0 10px 0 9px; border: 1px solid var(--box); border-radius: 999px; background: var(--card); color: var(--fg-2); font-size: 13.5px; font-weight: 600; }
  .lmenu > summary::-webkit-details-marker { display: none; }
  .lmenu > summary svg { width: 18px; height: 18px; color: var(--accent-text); } .lmenu > summary svg.chev { width: 13px; height: 13px; color: var(--muted); transition: transform .15s; }
  .lmenu[open] > summary svg.chev { transform: rotate(180deg); }
  .lmenu > summary:hover, .lmenu[open] > summary { border-color: var(--accent); }
  .lmenu ul { position: absolute; inset-inline-start: 0; top: calc(100% + 8px); z-index: 30; margin: 0; padding: 6px; list-style: none; min-width: 150px; background: var(--card); border: 1px solid var(--box); border-radius: 12px; box-shadow: 0 2px 4px rgba(15,23,42,.06), 0 24px 48px -16px rgba(15,23,42,.3); }
  .lmenu ul a { display: block; padding: 8px 12px; border-radius: 8px; text-decoration: none; color: var(--fg); font-weight: 500; }
  .lmenu ul a:hover, .lmenu ul a[aria-current="page"] { background: var(--tint); }
  /* Arabic: Noto Sans Arabic, no letter-spacing (it breaks the joined script), numbers kept left-to-right */
  html[lang="ar"] body { font-family: 'Noto Sans Arabic Variable', 'Inter Variable', system-ui, sans-serif; }
  html[lang="ar"] h1, html[lang="ar"] h2, html[lang="ar"] h3, html[lang="ar"] .fee, html[lang="ar"] .brand, html[lang="ar"] .card .name, html[lang="ar"] .pill, html[lang="ar"] .eyebrow { letter-spacing: 0; }
  html[lang="ar"] h1 { line-height: 1.35; } html[lang="ar"] p, html[lang="ar"] li, html[lang="ar"] td, html[lang="ar"] th { line-height: 1.75; }
  [dir="rtl"] .num, [dir="rtl"] .fee, [dir="rtl"] td.num, [dir="rtl"] .sub.num, [dir="rtl"] code, [dir="rtl"] pre, [dir="rtl"] textarea.code { direction: ltr; unicode-bidi: isolate; }
  [dir="rtl"] .brand span, [dir="rtl"] .lmenu span { unicode-bidi: isolate; }
  nav.main { display: flex; flex-wrap: wrap; gap: 2px; transition: opacity .22s ease, transform .22s ease; }
  /* Scrolling down hides the menu and keeps the logo and name; scrolling up brings it back (class set by the script below). */
  .header-spacer { height: var(--headh, 64px); }   /* holds the header's full height in the page flow; set by the script below */
  header.top .wrap { transition: min-height .2s ease, padding .2s ease; }
  header.top.scrolled nav.main { display: none; }
  header.top.scrolled .wrap { min-height: 44px; padding-block: 4px; }
  header.top.scrolled .brand { font-size: 15px; } header.top.scrolled .brand .mark { width: 26px; height: 26px; }
  header.top.scrolled .lmenu > summary { min-height: 30px; font-size: 12.5px; }
  .totop { position: fixed; inset-inline-end: 18px; bottom: 18px; z-index: 25; width: 46px; height: 46px; border-radius: 50%; border: 0; background: var(--accent); color: #fff; display: grid; place-items: center; cursor: pointer; box-shadow: 0 6px 18px -4px color-mix(in srgb, var(--accent) 60%, transparent), 0 2px 6px rgba(15,23,42,.15); opacity: 0; transform: translateY(12px) scale(.9); pointer-events: none; transition: opacity .22s ease, transform .22s ease, background .15s; }
  .totop[data-show="1"] { opacity: 1; transform: none; pointer-events: auto; }
  .totop:hover { background: color-mix(in srgb, var(--accent) 85%, #000); }
  .totop svg { width: 20px; height: 20px; }
  @media (prefers-reduced-motion: reduce) { nav.main, .totop { transition: none; } }
  @media (max-width: 360px) { nav.main a { font-size: 12px; padding-inline: 2px; } .brand { font-size: 12.5px; } }   /* very small phones: keep all six labels whole */
  nav.main a { padding: 7px 12px; border-radius: 10px; text-decoration: none; color: var(--fg-2); font-size: 14.5px; font-weight: 500; }
  nav.main a:hover { background: var(--tint); color: var(--fg); }
  nav.main a[aria-current="page"] { background: var(--fg); color: var(--bg); }
  /* Free embed: a green-bordered pill so it stands out from the rest of the menu */
  nav.main a.hl { border: 1.5px solid var(--accent); border-radius: 999px; color: var(--accent-text); font-weight: 600; padding-block: 6px; }
  nav.main a.hl:hover { background: var(--tint); color: var(--accent-text); }
  nav.main a.hl[aria-current="page"] { background: var(--accent); color: #fff; }
  main { padding-block: 20px 44px; }
  h1 { font-size: clamp(30px, 4.6vw, 44px); line-height: 1.1; margin: 0 0 10px; letter-spacing: -0.025em; font-weight: 700; }
  h2 { font-size: clamp(19px, 2.4vw, 24px); margin: 28px 0 10px; letter-spacing: -0.015em; font-weight: 650; }
  h2 a { color: inherit; text-decoration: none; }
  .eyebrow { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .eyebrow::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px color-mix(in srgb, var(--accent) 10%, transparent); } }
  @media (prefers-reduced-motion: reduce) { .eyebrow::before { animation: none; } }
  p.lead { color: var(--fg-2); margin: 0 0 14px; max-width: 64ch; font-size: 16px; }
  .meta { color: var(--muted); font-size: 13px; }
  .hero { position: relative; padding: 4px 0 16px; }
  .hero::before { content: ""; position: absolute; inset: -40px -10vw auto; height: 320px; background: radial-gradient(60% 80% at 20% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%), radial-gradient(40% 60% at 90% 10%, color-mix(in srgb, var(--accent-2) 12%, transparent), transparent 70%); pointer-events: none; z-index: -1; }
  .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  /* A grid that knows its card count (style="--n:7") lays all cards in one equal row on desktop, so there is no empty cell
     at the end; the fee shrinks a little when seven share the row. */
  @media (min-width: 1000px) {
    .grid[style*="--n"] { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
    .grid[style*="--n:7"] .fee, .grid[style*="--n:6"] .fee { font-size: 23px; }
    .grid[style*="--n:7"] .card, .grid[style*="--n:6"] .card { padding: 12px 13px; }
    .grid[style*="--n:7"] .name, .grid[style*="--n:6"] .name { font-size: 13px; }
    .grid[style*="--n:7"] .sub, .grid[style*="--n:6"] .sub { font-size: 12px; }
  }
  .card { background: var(--card); border: 1px solid var(--box); border-radius: var(--radius); padding: 14px 16px; box-shadow: var(--shadow); transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  a.card:hover { transform: translateY(-2px); border-color: var(--line-2); box-shadow: 0 2px 4px rgba(15,23,42,.05), 0 16px 32px -12px rgba(15,23,42,.18); }
  .card .name { font-weight: 600; color: var(--fg-2); font-size: 14px; letter-spacing: 0.01em; }
  .card .fee { font-size: 28px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; margin: 6px 0 2px; }
  .card .sub { color: var(--muted); font-size: 13px; }
  .card.rank-1 { border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 7%, var(--card)), var(--card)); }
  .num { font-variant-numeric: tabular-nums; }
  table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 14.5px; }
  th, td { text-align: start; padding: 9px 12px; border-block-end: 1px solid var(--line); vertical-align: top; }
  td.num, th.num, .nw { white-space: nowrap; }   /* numbers and short labels never break across lines */
  th { font-size: 12px; color: var(--muted); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; background: color-mix(in srgb, var(--card) 70%, var(--bg)); }
  tbody tr:last-child td { border-block-end: 0; }
  tbody tr:hover td { background: color-mix(in srgb, var(--tint) 60%, transparent); }
  th.sortable { cursor: pointer; user-select: none; } th.sortable::after { content: " ↕"; opacity: 0.45; }
  td.num, th.num { text-align: end; }
  .scroll, .tbl { overflow-x: auto; border: 1px solid var(--box); border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow); }
  .tbl table { min-width: 0; }
  .scroll table { min-width: 680px; } .scroll th, .scroll td { white-space: nowrap; }
  /* Coin cell: icon, ticker and name on one centred line (mirrors in RTL) */
  .coin { display: flex; align-items: center; gap: 8px; line-height: 1; }
  .coin a { display: inline-flex; align-items: center; gap: 8px; }
  .coin img { width: 20px; height: 20px; border-radius: 50%; flex: none; display: block; }
  .pill { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11.5px; line-height: 1.3; font-weight: 600; background: var(--tint); border: 1px solid var(--line); letter-spacing: 0.02em; vertical-align: middle; }
  td .pill { padding: 0 7px; font-size: 10.5px; line-height: 1.5; }   /* inside table rows: small enough to sit within the row */
  .pill.good { color: var(--good); } .pill.warn { color: var(--warn); } .pill.bad { color: var(--bad); }
  .best { color: var(--good); font-weight: 700; }
  .stale { color: var(--warn); }
  .two > .card { border-inline-start: 4px solid var(--accent); }
  .two { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); }
  .note { border: 1px solid var(--box); border-inline-start: 4px solid var(--accent); background: var(--card); padding: 12px 14px; border-radius: 12px; box-shadow: var(--shadow); }
  .note p { color: var(--fg-2); }
  .codebox { position: relative; }
  .codebox textarea.code { padding-inline-end: 96px; }
  .copy { position: absolute; inset-inline-end: 10px; top: 10px; display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 11px; border-radius: 9px; border: 1px solid var(--box); background: var(--card); color: var(--fg-2); font: 600 12.5px/1 inherit; font-family: inherit; cursor: pointer; }
  .copy:hover { border-color: var(--accent); color: var(--fg); } .copy[data-done="1"] { border-color: var(--accent); color: var(--accent); }
  .copy svg { width: 14px; height: 14px; }
  /* The code itself always reads left-to-right, so on Arabic pages the button stays at the physical right, where the code ends */
  [dir="rtl"] .copy { inset-inline-end: auto; inset-inline-start: 10px; }
  code, pre, textarea.code { font-family: var(--mono); font-size: 13px; }
  pre, textarea.code { background: var(--card); border: 1px solid var(--box); border-radius: 12px; padding: 14px; overflow: auto; width: 100%; direction: ltr; text-align: left; color: var(--fg-2); }
  button, select, input { font: inherit; }
  input, select { background: var(--bg-2); color: var(--fg); border: 1px solid var(--line-2); border-radius: 10px; min-height: 42px; padding: 0 12px; }
  input:focus-visible, select:focus-visible, a:focus-visible, button:focus-visible { outline: 3px solid color-mix(in srgb, var(--accent) 45%, transparent); outline-offset: 2px; }
  label { font-size: 13px; font-weight: 600; color: var(--fg-2); }
  .btn.cta { gap: 10px; min-height: 48px; padding: 0 22px; border-radius: 12px; font-size: 15.5px; text-decoration: none; box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--accent) 70%, transparent); transition: transform .15s ease, box-shadow .15s ease; }
  .btn.cta svg { width: 18px; height: 18px; transition: transform .15s ease; }
  .btn.cta:hover { transform: translateY(-1px); box-shadow: 0 12px 24px -8px color-mix(in srgb, var(--accent) 75%, transparent); } .btn.cta:hover svg { transform: translateX(3px); }
  .btn { display: inline-flex; align-items: center; min-height: 42px; padding: 0 18px; border: 0; border-radius: 10px; background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; font-weight: 600; cursor: pointer; }
  footer.bottom { border-block-start: 1px solid var(--line); padding: 18px 0 28px; color: var(--muted); font-size: 13px; }
  footer.bottom p { margin: 4px 0; max-width: 80ch; }
  details.fold > summary { cursor: pointer; margin: 28px 0 10px; list-style: none; } details.fold > summary::before { content: "▸ "; color: var(--muted); } details.fold[open] > summary::before { content: "▾ "; } details.fold > summary::-webkit-details-marker { display: none; }
  .spark { width: 120px; height: 32px; display: block; margin-top: 8px; color: var(--accent); }
  /* Facts card (exchange pages): label / value rows that wrap, currencies as chips */
  .facts { margin-top: 12px; padding: 4px 16px; display: grid; }
  .facts .row { display: grid; grid-template-columns: minmax(120px, 160px) minmax(0, 1fr); gap: 4px 16px; padding: 10px 0; border-block-end: 1px solid var(--line); align-items: start; }
  .facts .row:last-child { border-block-end: 0; }
  .facts .k { color: var(--muted); font-size: 14px; padding-top: 2px; }
  .facts .v { font-size: 14.5px; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .facts .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .facts .chip { display: inline-flex; align-items: baseline; gap: 6px; padding: 3px 10px; border-radius: 999px; background: var(--tint); border: 1px solid var(--box); font-size: 13px; }
  .facts .chip small { color: var(--muted); font-size: 12px; }
  @media (max-width: 640px) { .facts { padding: 2px 13px; } .facts .row { grid-template-columns: minmax(0, 1fr); gap: 4px; } }
  dl.kv { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; margin: 0; font-size: 14.5px; } dl.kv dt { color: var(--muted); min-width: 0; } dl.kv dd { margin: 0; text-align: end; white-space: nowrap; }
  /* Phones: two cards per row, tighter spacing, the six navigation links as a 3-column grid (no scrolling) */
  @media (max-width: 640px) {
    header.top .wrap { min-height: 56px; padding-block: 8px; gap: 6px 12px; }
    .lmenu > summary { min-height: 34px; padding: 0 8px; } .lmenu > summary span { display: none; }   /* phones: globe + arrow only, stays on the logo row */
    .lmenu ul { inset-inline-start: auto; inset-inline-end: 0; }   /* phones: the list hangs from the button's inner edge, away from the screen edge */
    .brand { font-size: 13.5px; gap: 8px; }
    nav.main { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; width: 100%; }
    nav.main a { padding: 7px 4px; font-size: 13px; white-space: nowrap; text-align: center; border: 1px solid var(--box); background: var(--card); overflow: hidden; text-overflow: ellipsis; }
    main { padding-block: 18px 40px; }
    .hero { padding-bottom: 14px; }
    h1 { font-size: 27px; }
    h2 { margin-top: 28px; }
    p.lead { font-size: 15.5px; margin-bottom: 14px; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .card { padding: 12px 13px; border-radius: 13px; }
    .card .name { font-size: 12.5px; line-height: 1.25; }
    .card .fee { font-size: 22px; margin: 4px 0 0; }
    .card .sub { font-size: 11.5px; line-height: 1.35; }
    .spark { width: 100%; height: 26px; margin-top: 6px; }
    .two { gap: 10px; }
    .note, .card { font-size: 14.5px; }
    th, td { padding: 9px 10px; font-size: 13.5px; }
    .scroll table { min-width: 560px; }
    .asset-long { display: none; }
  }
</style>
<script src="https://analytics.ahrefs.com/analytics.js" data-key="jClVNTnV7HJc9U2SEQdugA" async></script>  <!-- Ahrefs web analytics; pages only, never inside the embed widgets -->
</head>
<body>
<header class="top"><div class="wrap">
  <a class="brand" href={L('/')}><img class="mark" src="/logo-32.png" srcset="/logo-32.webp 1x, /logo-64.webp 2x" alt="" width="32" height="32"><span>{t(lang, 'site.name')}</span></a>
  <div class="tools">
  <a class="tg" href="https://t.me/cryptofeeindex" rel="nofollow noopener" target="_blank" aria-label={t(lang, 'nav.telegram')} title={t(lang, 'nav.telegram')}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.7 3.3 2.9 10.6c-1.1.4-1.1 1.1-.2 1.4l4.7 1.5 1.8 5.6c.2.6.4.8.8.8.5 0 .7-.2 1-.5l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l3.2-15c.3-1.3-.5-1.9-1.3-1.6ZM8 13.1l9.8-6.2c.5-.3.9-.1.6.2l-8 7.2-.3 3.3L8 13.1Z"/></svg></a>
  <details class="lmenu"><summary aria-label={t(lang, 'lang.label')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c3 3.2 3 15.8 0 19M12 2.5c-3 3.2-3 15.8 0 19"/></svg><span>{LANG_NAMES[lang]}</span><svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
    <ul role="list">{LANGS.map((l) => <li><a href={langPath(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>{LANG_NAMES[l]}</a></li>)}</ul>
  </details>
  </div>
  <nav class="main" aria-label={t(lang, 'nav.aria')}>{NAV.map(([p, k]) => <a href={L(p)} class={k === 'nav.embed' ? 'hl' : undefined} aria-current={path === L(p) ? 'page' : undefined}>{t(lang, k)}</a>)}</nav>
</div></header>
<div class="header-spacer" aria-hidden="true"></div>
<button type="button" class="totop" id="totop" aria-label={t(lang, 'nav.top')} title={t(lang, 'nav.top')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
<script is:inline>
  (function () {
    var head = document.querySelector('header.top'), top = document.getElementById('totop'), last = window.scrollY, ticking = false;
    function measure() { var was = head.classList.contains('scrolled'); head.classList.remove('scrolled'); document.documentElement.style.setProperty('--headh', head.offsetHeight + 'px'); if (was) head.classList.add('scrolled'); }
    measure(); window.addEventListener('resize', measure);
    function update() {
      var y = window.scrollY, d = y - last;
      if (Math.abs(d) < 12 && y > 80) { ticking = false; return; }       // ignore tiny moves (rubber-banding, layout nudges)
      if (y > 80 && d > 0) head.classList.add('scrolled');               // going down: menu away
      else if (d < 0 || y <= 80) head.classList.remove('scrolled');      // going up or near the top: menu back
      top.dataset.show = y > 400 ? '1' : '';
      last = y; ticking = false;
    }
    window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    top.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }); });
    update();
  })();
</script>
<main class="wrap">
  {updated && <p class="meta" data-live="updated">{t(lang, 'updated', { time: fmtTime(lang, updated) })}</p>}
  <slot />
</main>
<footer class="bottom"><div class="wrap">
  <p>{t(lang, 'site.footer_note')}</p>
  <p>{t(lang, 'site.footer_project')} · <a href={L('/methodology/')}>{t(lang, 'nav.methodology')}</a></p>
</div></footer>
<script is:inline define:vars={{ lang }}>
  // Live refresh: every 5 minutes, re-read the published JSON and update any element tagged data-live-fee="<network>" (USD)
  (function () {
    var iso = function (x) { return lang === 'ar' ? '\u2066' + x + '\u2069' : x; }; var fmt = function (v) { return iso(new Intl.NumberFormat('en', { style: 'currency', currency: 'USD', maximumFractionDigits: v < 0.01 ? 4 : v < 1 ? 3 : 2 }).format(v)); };
    function tick() {
      fetch('/data/fees.json', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
        document.querySelectorAll('[data-live-fee]').forEach(function (el) { var k = el.getAttribute('data-live-fee').split(':'), n = d.assets[k[0]] && d.assets[k[0]].networks[k[1]]; if (n && n.fee_usd != null) el.textContent = fmt(n.fee_usd); });
        var u = document.querySelector('[data-live="updated"]'); if (u && d.generated_at) u.textContent = u.textContent.replace(/\S.*$/, '').trim() ? u.textContent : u.textContent;
      }).catch(function () {});
    }
    setInterval(tick, 5 * 60 * 1000);
  })();
  // the asset picker (<details>): a click outside or Escape closes it
  document.addEventListener('click', function (e) { document.querySelectorAll('details.apick[open], details.lmenu[open]').forEach(function (d) { if (!d.contains(e.target)) d.removeAttribute('open'); }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') document.querySelectorAll('details.apick[open], details.lmenu[open]').forEach(function (d) { d.removeAttribute('open'); }); });
  // Keep the open list inside the screen: if it would run past the right edge (phones), shift it left by the overflow.
  document.querySelectorAll('details.apick, details.lmenu').forEach(function (d) { d.addEventListener('toggle', function () {
    var ul = d.querySelector('ul'); if (!ul) return; ul.style.insetInlineStart = '';
    if (!d.open) return;
    // visualViewport = the part of the page on screen, which matters when the phone is pinch-zoomed in.
    var vv = window.visualViewport, vL = vv ? vv.offsetLeft : 0, vR = vv ? vv.offsetLeft + vv.width : window.innerWidth;
    var r = ul.getBoundingClientRect(), pad = 12, over = r.right - (vR - pad), under = (vL + pad) - r.left;
    if (over > 0) ul.style.insetInlineStart = -Math.min(over, Math.max(0, r.left - vL - pad)) + 'px';
    else if (under > 0) ul.style.insetInlineStart = under + 'px';
  }); });
</script>
</body>
</html>
