---
// The embeddable widget shell: tiny, self-contained, no analytics or trackers, refreshes itself every 5 minutes, credit link
// with a branded anchor only. GitHub Pages sends no X-Frame-Options, so any site may frame these pages.
import { t, SITE_URL } from '../data';
interface Props { lang: string; title: string; refresh: string }
const { lang, title, refresh } = Astro.props;
---
<!doctype html><html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex"><link rel="icon" href="/favicon.png" type="image/png"><title>{title}</title>
<style>
  :root { color-scheme: light dark; --bg: #ffffff; --fg: #0f172a; --muted: #64748b; --line: #e2e8f0; --accent: #0f9d8e; }
  @media (prefers-color-scheme: dark) { :root { --bg: #0f1522; --fg: #e6edf7; --muted: #8b98a8; --line: #1e2a3a; --accent: #2dd4bf; } }
  html, body { margin: 0; background: var(--bg); color: var(--fg); font: 14px/1.4 Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .w { padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; min-height: 120px; box-sizing: border-box; background: var(--bg); }
  .t { font-size: 11px; color: var(--accent); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
  .n { font-size: 17px; font-weight: 600; margin-top: 6px; } .f { font-size: 30px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }
  .s { color: var(--muted); font-size: 12px; margin-top: 4px; } a { color: var(--accent); }
</style></head><body><div class="w"><slot /><div class="s" data-credit set:html={t(lang, 'widget.credit', { site: `<a href="${SITE_URL}/${lang}/" target="_blank" rel="noopener">${t(lang, 'site.name')}</a>` })}></div></div>
<script is:inline define:vars={{ refresh, lang }}>
  (function () { var fmt = function (v) { return new Intl.NumberFormat('en', { style: 'currency', currency: 'USD', maximumFractionDigits: v < 0.01 ? 4 : v < 1 ? 3 : 2 }).format(v); };
    setInterval(function () { fetch('/data/fees.json', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
      var p = refresh.split(':');
      if (p[0] === 'cheapest') { var b = Object.values(d.assets[p[1]].networks).filter(function (n) { return n.fee_usd != null; }).sort(function (a, c) { return a.fee_usd - c.fee_usd; })[0]; if (b) { document.querySelector('.n').textContent = b.name; document.querySelector('.f').textContent = fmt(b.fee_usd); } }
      else { var n = d.assets[p[0]] && d.assets[p[0]].networks[p[1]]; if (n) document.querySelector('.f').textContent = fmt(n.fee_usd); }
    }).catch(function () {}); }, 5 * 60 * 1000); })();
</script></body></html>
