---
// The embeddable widget shell: tiny, self-contained, no analytics or trackers, refreshes itself every 5 minutes, credit link
// with a branded anchor only. frame-ancestors * is set for /embed/* in public/_headers.
import { t, SITE_URL } from '../data';
interface Props { lang: string; title: string; refresh: string }
const { lang, title, refresh } = Astro.props;
---
<!doctype html><html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><title>{title}</title>
<style>
  :root { color-scheme: light dark; --bg: #fff; --fg: #15191e; --muted: #5b6672; --line: #e3e7ec; --accent: #0b6d63; }
  @media (prefers-color-scheme: dark) { :root { --bg: #0e1217; --fg: #e8ecf1; --muted: #9aa5b1; --line: #263040; --accent: #3dd6c3; } }
  html, body { margin: 0; background: var(--bg); color: var(--fg); font: 14px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  .w { padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; min-height: 120px; box-sizing: border-box; }
  .t { font-size: 12px; color: var(--muted); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .n { font-size: 18px; font-weight: 700; margin-top: 4px; } .f { font-size: 28px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .s { color: var(--muted); font-size: 12px; margin-top: 4px; } a { color: var(--accent); }
</style></head><body><div class="w"><slot /><div class="s" data-credit set:html={t(lang, 'widget.credit', { site: `<a href="${SITE_URL}/${lang}/" target="_blank" rel="noopener">${t(lang, 'site.name')}</a>` })}></div></div>
<script is:inline define:vars={{ refresh, lang }}>
  (function () { var fmt = function (v) { return new Intl.NumberFormat(lang, { style: 'currency', currency: 'USD', maximumFractionDigits: v < 0.01 ? 4 : v < 1 ? 3 : 2 }).format(v); };
    setInterval(function () { fetch('/data/networks.json', { cache: 'no-store' }).then(function (r) { return r.json(); }).then(function (d) {
      if (refresh === 'cheapest') { var b = Object.values(d.networks).filter(function (n) { return n.token === 'USDT' && n.fee_usd != null; }).sort(function (a, c) { return a.fee_usd - c.fee_usd; })[0]; if (b) { document.querySelector('.n').textContent = b.name; document.querySelector('.f').textContent = fmt(b.fee_usd); } }
      else { var n = d.networks[refresh]; if (n) document.querySelector('.f').textContent = fmt(n.fee_usd); }
    }).catch(function () {}); }, 5 * 60 * 1000); })();
</script></body></html>
