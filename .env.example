# Gulf Crypto Fee & Transfer Index: every variable the scripts read. Copy to .env (never committed). All keys READ-ONLY, no trade/withdraw permissions.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# optional: Crypto.com Exchange read-only key (else the manual sheet is used)
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=
# optional free keys that raise rate limits
TRONGRID_API_KEY=
TONAPI_KEY=
COINGECKO_API_KEY=
# alerts by email: any SMTP account (e.g. a Gmail app password); without these, alerts are only logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
ALERT_FROM=
# deploys from GitHub Actions (repository secrets, not needed locally)
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=
