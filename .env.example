# Crypto Fee & Transfer Index: every variable the scripts read. Copy to .env (never committed). All keys READ-ONLY, no trade/withdraw permissions.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Bybit host for the account's entity: api.bybit.eu (EU accounts, the default) or api.bybit.com (global)
BYBIT_API_HOST=api.bybit.eu
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# OKX host for the account's entity: eea.okx.com (EEA accounts, the default) or www.okx.com (global)
OKX_API_HOST=eea.okx.com
# optional: Crypto.com Exchange read-only key (else the manual sheet is used)
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=
# optional free keys that raise rate limits
TRONGRID_API_KEY=
TONAPI_KEY=
COINGECKO_API_KEY=
# alerts by email: any SMTP account (e.g. a Gmail app password); without these, alerts are only logged
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
ALERT_FROM=
# hosting: GitHub Pages, published by the workflow (no tokens needed; Pages must be enabled in the repo settings)
